<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent" android:gravity="center" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textSize="42sp" android:textColor="#FF9933" />
    <TextView android:id="@+id/status" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="16sp"
        android:textColor="#FFFFFF" android:layout_marginTop="8dp" />
    <Button android:id="@+id/btnTorch" android:layout_width="220dp" android:layout_height="110dp"
        android:layout_marginTop="28dp" android:text="TURN ON" />
    <Button android:id="@+id/btnScreen" android:layout_width="220dp" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="SCREEN LIGHT (fallback)" />
    <Button android:id="@+id/btnTile" android:layout_width="220dp" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="ADD QUICK-SETTINGS TILE" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:orientation="horizontal">
        <TextView android:id="@+id/linkPrivacy" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Privacy"
            android:textColor="#FFC107" android:paddingEnd="16dp" />
        <TextView android:id="@+id/linkTerms" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Terms"
            android:textColor="#FFC107" android:paddingEnd="16dp" />
        <TextView android:id="@+id/linkAbout" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="About" android:textColor="#FFC107" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#AAAAAA" android:layout_marginTop="20dp"
        android:text="Made with  by Aman Shankhdhar Ji" />
</LinearLayout>
