<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="#1E1E1E" android:padding="32dp" android:gravity="center_horizontal">

    <TextView android:text="Darkness Detected 🌑" android:textColor="#FFFFFF" android:textSize="20sp"
        android:fontFamily="sans-serif-medium" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <TextView android:id="@+id/txtCountdown" android:text="Turning on in 3..." android:textColor="#FF9933"
        android:textSize="16sp" android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:max="3000" android:progress="3000"
        android:progressTint="#FF9933"/>

    <Button android:id="@+id/btnCancel" android:text="DON'T TURN ON" android:backgroundTint="#FF5252" android:textColor="#FFFFFF"
        android:textStyle="bold" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="56dp"/>
</LinearLayout>