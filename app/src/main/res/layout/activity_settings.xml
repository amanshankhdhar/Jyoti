<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/black">
    <LinearLayout android:orientation="vertical" android:padding="24dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="SETTINGS" android:textColor="@color/saffron" android:textSize="28sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Switch android:id="@+id/swSound" android:text="Click sound" android:textColor="#FFFFFF"
            android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Switch android:id="@+id/swHaptic" android:text="Vibration feedback" android:textColor="#FFFFFF"
            android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Switch android:id="@+id/swShake" android:text="Shake to toggle" android:textColor="#FFFFFF"
            android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Switch android:id="@+id/swClap" android:text="Clap to light" android:textColor="#FFFFFF"
            android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Switch android:id="@+id/swDark" android:text="Auto-on in darkness" android:textColor="#FFFFFF"
            android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/txtVer" android:text="Jyoti v2.0.0" android:textColor="#888888"
            android:layout_marginTop="24dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
