<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:padding="24dp">

    <TextView android:text="TEXT TO MORSE" android:textColor="#FF9933" android:textSize="24sp"
        android:fontFamily="sans-serif-medium" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <EditText android:id="@+id/etInput" android:hint="Type something (e.g. HELP)"
        android:textColor="#FFFFFF" android:textColorHint="#666666" android:backgroundTint="#FF9933"
        android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <TextView android:id="@+id/txtMorsePreview" android:text=".... . .-.. ." android:textColor="#FFC107"
        android:textSize="28sp" android:fontFamily="monospace" android:letterSpacing="0.2"
        android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <Button android:id="@+id/btnFlash" android:text="FLASH MORSE" android:backgroundTint="#FF9933" android:textColor="#000000"
        android:textStyle="bold" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="56dp"/>

    <Button android:id="@+id/btnStop" android:text="STOP" android:backgroundTint="#FF5252" android:textColor="#FFFFFF"
        android:textStyle="bold" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="56dp"/>
</LinearLayout>