<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center_horizontal" android:background="#000000" android:padding="24dp">

    <TextView android:text="@string/app_name" android:textColor="#FF9933" android:textSize="36sp"
        android:fontFamily="sans-serif-medium" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <TextView android:id="@+id/badge" android:text="TORCH INACTIVE" android:textColor="#888888"
        android:textSize="14sp" android:letterSpacing="0.1"
        android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <ImageButton android:id="@+id/btnPower" android:layout_width="160dp" android:layout_height="160dp"
        android:layout_marginTop="32dp" android:src="@drawable/ic_power" android:background="@drawable/power_bg"
        android:scaleType="center" android:contentDescription="power"/>

    <SeekBar android:id="@+id/seekStrength" android:layout_width="260dp" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:visibility="gone" android:progressTint="#FF9933"/>

    <LinearLayout android:orientation="horizontal" android:layout_marginTop="32dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content">
        <Button android:id="@+id/btnEffects" android:text="EFFECTS" android:backgroundTint="#1E1E1E" android:textColor="#FFFFFF"
            android:layout_width="120dp" android:layout_height="56dp" android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/btnScreen" android:text="SCREEN" android:backgroundTint="#1E1E1E" android:textColor="#FFFFFF"
            android:layout_width="120dp" android:layout_height="56dp"/>
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:layout_marginTop="12dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content">
        <Button android:id="@+id/btnDashboard" android:text="STATS" android:backgroundTint="#1E1E1E" android:textColor="#FFFFFF"
            android:layout_width="120dp" android:layout_height="56dp" android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/btnSettings" android:text="SETTINGS" android:backgroundTint="#1E1E1E" android:textColor="#FFFFFF"
            android:layout_width="120dp" android:layout_height="56dp"/>
    </LinearLayout>

    <Button android:id="@+id/btnDonate" android:text="SUPPORT JYOTI" android:backgroundTint="#FF9933" android:textColor="#000000"
        android:textStyle="bold" android:layout_marginTop="24dp" android:layout_width="248dp" android:layout_height="56dp"/>

    <TextView android:id="@+id/txtVer" android:text="v3.0.0" android:textColor="#444444"
        android:layout_marginTop="24dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>