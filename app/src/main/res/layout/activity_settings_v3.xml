<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <LinearLayout android:orientation="vertical" android:padding="24dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">

        <TextView android:text="SETTINGS" android:textColor="#FF9933" android:textSize="28sp"
            android:fontFamily="sans-serif-medium" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <!-- Feedback -->
        <TextView android:text="Feedback" android:textColor="#888888" android:textSize="14sp" android:layout_marginTop="24dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Switch android:id="@+id/swHaptic" android:text="Haptic Vibration" android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Switch android:id="@+id/swSound" android:text="Click Sound" android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- Automation -->
        <TextView android:text="Automation &amp; Sensors" android:textColor="#888888" android:textSize="14sp" android:layout_marginTop="24dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        
        <Switch android:id="@+id/swShake" android:text="Shake to Toggle" android:textColor="#FFFFFF"
            android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <SeekBar android:id="@+id/seekShake" android:max="100" android:progress="50" android:progressTint="#FF9933"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/txtShakeSens" android:text="Shake Sensitivity: Medium" android:textColor="#AAAAAA" android:textSize="12sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <Switch android:id="@+id/swClap" android:text="Clap to Light" android:textColor="#FFFFFF"
            android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <SeekBar android:id="@+id/seekClap" android:max="100" android:progress="50" android:progressTint="#FF9933"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/txtClapSens" android:text="Clap Sensitivity: Medium" android:textColor="#AAAAAA" android:textSize="12sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <Switch android:id="@+id/swDark" android:text="Auto-on in Darkness (Screen ON)" android:textColor="#FFFFFF"
            android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- Support & Info -->
        <Button android:id="@+id/btnIssue" android:text="REPORT BUG / RAISE ISSUE" android:backgroundTint="#1E1E1E" android:textColor="#FFFFFF"
            android:layout_marginTop="32dp" android:layout_width="match_parent" android:layout_height="56dp"/>

        <TextView android:id="@+id/txtVer" android:text="Jyoti v3.0.0" android:textColor="#444444"
            android:layout_marginTop="24dp" android:layout_gravity="center"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>