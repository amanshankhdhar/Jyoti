<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:padding="24dp">

    <TextView android:text="DASHBOARD" android:textColor="#FF9933" android:textSize="28sp"
        android:fontFamily="sans-serif-medium" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <LinearLayout android:orientation="vertical" android:background="#1E1E1E" android:padding="24dp"
        android:layout_marginTop="32dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="Usage Today" android:textColor="#888888" android:textSize="14sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/txtUsage" android:text="0m 0s" android:textColor="#FFFFFF" android:textSize="32sp"
            android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:orientation="vertical" android:background="#1E1E1E" android:padding="24dp"
        android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="Battery Level" android:textColor="#888888" android:textSize="14sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/txtBattery" android:text="--%" android:textColor="#FFC107" android:textSize="32sp"
            android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>