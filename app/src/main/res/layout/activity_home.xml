<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center_horizontal" android:background="@color/black" android:padding="24dp">
    <TextView android:text="@string/app_name" android:textColor="@color/saffron" android:textSize="40sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/badge" android:text="TORCH INACTIVE" android:textColor="@color/amber"
        android:background="@drawable/badge_bg" android:paddingHorizontal="16dp" android:paddingVertical="6dp"
        android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <ImageButton android:id="@+id/btnPower" android:layout_width="150dp" android:layout_height="150dp"
        android:layout_marginTop="24dp" android:src="@drawable/ic_power" android:background="@drawable/power_bg"
        android:scaleType="center" android:contentDescription="power"/>
    <SeekBar android:id="@+id/seekStrength" android:layout_width="240dp" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:visibility="gone"/>
    <LinearLayout android:orientation="horizontal" android:layout_marginTop="16dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content">
        <Button android:id="@+id/btnEffects" android:text="SOS / STROBE"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnScreen" android:text="SCREEN LIGHT"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_marginTop="8dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content">
        <Button android:id="@+id/btnSettings" android:text="SETTINGS"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnTile" android:text="ADD QS TILE"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <Spinner android:id="@+id/spinTimer" android:entries="@array/timer_entries"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
    <LinearLayout android:orientation="horizontal" android:layout_marginTop="20dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content">
        <TextView android:id="@+id/linkPrivacy" android:text="Privacy" android:textColor="@color/amber"
            android:paddingEnd="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/linkTerms" android:text="Terms" android:textColor="@color/amber"
            android:paddingEnd="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/linkAbout" android:text="About" android:textColor="@color/amber"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView android:text="Made with 🙏 by Aman Shankhdhar Ji" android:textColor="#888888"
        android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
