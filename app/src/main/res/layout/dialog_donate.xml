<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="#121212" android:padding="24dp" android:gravity="center_horizontal">

    <TextView android:text="Support Jyoti 🪔" android:textColor="#FF9933" android:textSize="24sp"
        android:fontFamily="sans-serif-medium" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <TextView android:text="If Jyoti helped you, consider buying me a chai!"
        android:textColor="#CCCCCC" android:textSize="14sp" android:gravity="center"
        android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <ImageView android:id="@+id/imgQR" android:layout_width="200dp" android:layout_height="200dp"
        android:layout_marginTop="24dp" android:background="#FFFFFF" android:padding="8dp"
        android:contentDescription="UPI QR Code"/>

    <TextView android:id="@+id/txtUPI" android:text="@string/upi_id" android:textColor="#FFC107"
        android:textSize="16sp" android:fontFamily="monospace"
        android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <Button android:id="@+id/btnPay" android:text="PAY VIA UPI APP" android:backgroundTint="#FF9933" android:textColor="#000000"
        android:textStyle="bold" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="56dp"/>

    <Button android:id="@+id/btnClose" android:text="CLOSE" android:backgroundTint="#333333" android:textColor="#FFFFFF"
        android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="48dp"/>
</LinearLayout>